rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for SmartDairy AI Hackathon MVP
    match /farms/{farmId} {
      allow read: if true;
      allow write: if true;
    }
    match /advisory_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
